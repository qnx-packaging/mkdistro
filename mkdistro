#!/usr/bin/env bash

# mkdistro <preset>

# global variables
preset_path=""
preset_name=""
fakeroot_save=""
scripts_dir="$(realpath ./scripts)"
common_dir="$(realpath ./common)"
tmp_dir=""
apk_root=""
apk_lockfile=""
root_partition_filelist=""
root_partition_out=""
boot_partition_filelist=""
boot_partition_out=""
disk_layout_filelist=""
disk_layout_out=""

# preset variables
arch=""
boot_partition_type=""
boot_partition_size=0
boot_partition_layout=""
mkdyifs_preset=""
image_size=0
image_format=""
image_inodes=""
repositories=()
local_repositories=()
packages=()
keys=()
users=""
groups=""
openrc_services=()
declare -A openrc_confd=()

get_app_cache() {
  local app_name="$1"
  local base_cache

  if [[ -n "${XDG_CACHE_HOME}" ]]; then
    base_cache="${XDG_CACHE_HOME}"
  elif [[ "$(uname -s)" = "Darwin" ]]; then
    base_cache="${HOME}/Library/Caches"
  else
    base_cache="${HOME}/.cache"
  fi

  local app_cache_dir="${base_cache}/${app_name}"
  mkdir -p "${app_cache_dir}"

  echo "${app_cache_dir}"
}

to_bytes() {
  numfmt --from=iec "${1}"
}

from_bytes() {
  numfmt --to=iec "${1}" --format="%.2f" | sed -E 's/0+([A-Z]*)$/\1/; s/\.([A-Z]*)$/\1/'
}

usage() {
  echo ""
}

msg() {
  printf '[mkdistro] %s\n' "${1}"
}

msg_error() {
  printf '[mkdistro] ERROR: %s\n' "${1}"
  if ((${2} > 0)); then
    exit "${2}"
  fi
}

msg_fatal() {
  printf '[mkdistro] FATAL: %s\n' "${1}"
  return 1
}

assert() {
  local var_name="${1}"
  shift
  local var_value="${!var_name}"

  if [[ -z "${var_value}" ]]; then
    msg_error "'${var_name}' is empty or unset" 1
  fi

  if [[ $# -eq 0 ]]; then
    return 0
  fi

  local validator="${1}"
  shift

  if ! "${validator}" "${var_value}" "$@"; then
    msg_error "'${var_name}' = '${var_value}' failed ${validator[$*]}" 1
  fi

  return 0
}

assert_arr() {
  local name="$1"
  shift
  local -a arr=("${!name[@]}")

  if [[ ${#arr[@]} -eq 0 ]]; then
    msg_error "array '${name}' is empty or unset" 1
  fi

  if [[ $# -eq 0 ]]; then
    return 0
  fi

  local validator="${1}"
  shift

  if ! "${validator}" "$@" "${arr[@]}"; then
    msg_error "array '${name}' failed ${validator}" 1
  fi
  return 0
}

# Every key is an absolute path with no internal spaces.
_check_path_abs() {
  local val="${1}"
  if [[ ! "${val}" =~ ^/[^[:space:]]*$ ]]; then
    return 1
  fi
  return 0
}

_check_local_repo_format() {
  local val="${1}"
  if [[ "${val}" == "*::*" ]]; then
    val="${val#*::}"
    local embed_path="${val%%::*}"
    _check_path_abs "${embed_path}"
  fi

  _check_path_abs "${val}"
}

assert_arr_keys() {
  local name="$1"
  local -n array_ref="${name}"
  shift
  local -a keys=("${!array_ref[@]}")

  if [[ ${#keys[@]} -eq 0 ]]; then
    msg_error "keys of '${name}' is empty or unset" 1
  fi

  if [[ $# -eq 0 ]]; then
    return 0
  fi

  local validator="$1"
  shift
  local k

  for k in "${keys[@]}"; do
    if ! "${validator}" "${k}" "${@}"; then
      msg_error "keys '${name}[\"${k}\"]' failed ${validator}" 1
    fi
  done
  return 0
}

_check_oneof() {
  local val="${1}"
  shift
  local opt
  for opt in "${@}"; do
    [[ "${val}" == "${opt}" ]] && return 0
  done
  return 1
}

assert_oneof() {
  local var_name="${1}"
  shift
  assert "${var_name}" _check_oneof "$@"
}

_check_num_or_auto() {
  local v="$1"
  local s="${2-auto}"
  [[ "${v}" == "${s}" ]] && return 0
  [[ "${v}" =~ ^-?[0-9]+$ ]] && return 0
  return 1
}
assert_num_or_auto() {
  local n="$1"
  shift
  assert "${n}" _check_num_or_auto "$@"
}

_check_size_or_auto() {
  local v="$1"
  local s="${2-auto}"
  [[ "${v}" == "${s}" ]] && return 0
  [[ "${v}" =~ ^[0-9]+[GMT]$ ]] && return 0
  return 1
}
assert_size_or_auto() {
  local n="$1"
  shift
  assert "${n}" _check_size_or_auto "$@"
}

assert_empty() {
  local var_name="$1"
  shift
  if [[ -n "${!var_name}" ]]; then
    msg_error "'${var_name}' = '${!var_name}' should be empty" 1
  fi
  return 0
}

generate_image() {
  # We need a bit of padding 4096 ends up being a extra page
  local sectors=$((($(to_bytes "${image_size}") + (4096 * 512)) / 512))
  msg "Generating disk image"

  cat <<EOF >"${disk_layout_filelist}"
[cylinders=${sectors}]
[heads=1 sectors_per_track=1 sector_size=512 start_at_cylinder=2048]
[partition=1 type_guid="${boot_partition_type}" boot=true] "${boot_partition_out}"
[partition=2 type_guid="qnx6"] "${root_partition_out}"
EOF

  diskimage -g -S -c "${disk_layout_filelist}" -o "${disk_layout_out}" >/dev/null

  if [[ ${image_format} == "qcow2" ]]; then
    msg "Converting to qcow2 format"
    qemu-img convert -f raw -O qcow2 -c -S 4k "${disk_layout_out}" "${disk_layout_out%.*}.qcow2}"
    disk_layout_out="${disk_layout_out%.*}.qcow2}"
  fi
}

generate_boot_partition() {
  local sectors="$1"
  local layout_path=""

  msg "Generating boot partition with size $(from_bytes $((sectors * 512)))"

  echo "[num_sectors=${sectors}]" >"${boot_partition_filelist}"
  echo "[search=${tmp_dir}]" >>"${boot_partition_filelist}"

  if [[ "${boot_partition_type}" == "efi" && "${boot_partition_layout}" == "" ]]; then
    layout_path="${common_dir}/efi_${arch}.build"
  fi
  #TODO: support custom partition layouts

  cat "${layout_path}" >>"${boot_partition_filelist}"

  mkfatfsimg -r "${tmp_dir}" "${boot_partition_filelist}" "${boot_partition_out}"
}

generate_root_partition() {
  local sectors="$1"

  if [[ ${image_inodes} == "auto" ]]; then
    echo "[num_sectors=${sectors}]" >"${root_partition_filelist}"
  else
    echo "[num_sectors=${sectors} num_inodes=${image_inodes}]" >"${root_partition_filelist}"
  fi
  fakeroot -i "${fakeroot_save}" -- "${scripts_dir}/filelist-gen.sh" "${apk_root}" "${root_partition_filelist}"

  msg "Generating root partition with size $(from_bytes $((sectors * 512)))"

  mkqnx6fsimg -d "${root_partition_filelist}" "${root_partition_out}"
}

generate_partitions() {
  local boot_sectors=0
  local root_sectors=0

  boot_sectors="$(($(to_bytes "${boot_partition_size}") / 512))"
  # Root sectors is the amount of space left AFTER the boot partition
  root_sectors=$((($(to_bytes "${image_size}") / 512) - boot_sectors))

  generate_boot_partition "${boot_sectors}"
  generate_root_partition "${root_sectors}"
}

copy_overlay() {
  fakeroot -i "${fakeroot_save}" -s "${fakeroot_save}" -- install -d -m0775 -o 0 -g 0 -- "${apk_root}"

  if [[ -d "${preset_path}/overlay" ]]; then
    msg "Copying custom overlay"
    cp -afv --no-preserve=ownership,mode -- "${preset_path}/overlay/." "${apk_root}"

    #TODO: file permissions
  fi

}

configure_openrc() {
  local openrc_service=""
  # Enable top level services
  for openrc_service in "${openrc_services[@]}"; do
    fakeroot -i "${fakeroot_save}" -s "${fakeroot_save}" -- \
      "${scripts_dir}/openrc-enable-service.sh" "${apk_root}" "${openrc_service}"
  done

  # Configure services
  for openrc_service in "${!openrc_confd[@]}"; do
    fakeroot -i ${fakeroot_save} -s ${fakeroot_save} -- \
      "${scripts_dir}/openrc-configure-service.sh" "${apk_root}" "${openrc_service}" <(cat <<<"${openrc_confd[${openrc_service}]}")
  done
}

make_apk_root() {
  local args=()
  args+=("--root" "${apk_root}")
  args+=("--arch" "${arch}")
  args+=("--lockfile" "${apk_lockfile}")

  local repo=""
  for repo in "${repositories[@]}"; do
    args+=("--repo" "${repo}")
  done

  local key=""
  for key in "${keys[@]}"; do
    args+=("--key" "${key}")
  done

  for repo in "${local_repositories[@]}"; do
    if [[ "${repo}" == *::* ]]; then
      repo="${repo#*::}"
    fi

    args+=("--repo" "$(realpath "${repo}")")
  done

  fakeroot -i ${fakeroot_save} -s "${fakeroot_save}" -- "${scripts_dir}/apk-dump.sh" "${args[@]}" "${packages[@]}"

  local repo_embed_path=""
  msg "copying local repositories"
  for repo in "${local_repositories[@]}"; do
    if [[ "${repo}" == *::* ]]; then
      repo_embed_path="${repo%%::*}"
      repo="${repo#*::}"
    fi

    msg "copying \"${repo}\" to \"<apk-root>${repo_embed_path}\""

    sed -i "s|""${repo}""|${repo_embed_path}|g" "${apk_root}/etc/apk/repositories"
    fakeroot -i "${fakeroot_save}" -s "${fakeroot_save}" -- mkdir -p "${apk_root}/${repo_embed_path}"
    fakeroot -i "${fakeroot_save}" -s "${fakeroot_save}" -- cp -r "${repo}/${arch}" "${apk_root}/${repo_embed_path}/${arch}"
  done
}

build_image() {
  copy_overlay
  make_apk_root
  configure_openrc
  #TODO: password and skel
  #TODO: mydyifs
  echo "" >"${tmp_dir}/ifs.bin"

  generate_partitions
  generate_image

  echo "TODO"
}

validate_preset() {
  assert_oneof arch "x86_64" "aarch64":
  assert_size_or_auto boot_partition_size
  assert boot_partition_type

  if [[ "${boot_partition_type}" == "efi" ]]; then
    if ! [[ -z "${boot_partition_layout}" ]]; then
      assert boot_partition_layout
    fi
  else
    assert boot_partition_layout
  fi

  assert_size_or_auto image_size
  assert_oneof image_format "iso" "qcow2"

  if [[ ${image_format} == "qcow2" ]] && ! command -v git &>/dev/null; then
    msg_error "qcow2 format request but command \"qemu-img\" not found"
  fi

  assert_num_or_auto image_inodes

  assert_arr repositories
  assert_arr local_repositories

  assert_arr keys
  assert_arr packages

  assert users
  assert groups

  assert_arr openrc_services
  #assert_arr_keys openrc_confd
}

read_preset() {
  if [[ ! -d "${preset_path}" ]]; then
    msg_error "Preset at '${preset_path}' does not exists" 1
  elif [[ ! -e "${preset_path}/preset.sh" ]]; then
    msg_error "Preset at '${preset_path}' does not contain a 'preset.sh' file" 1
  fi

  cd -- "${preset_path}" || msg_fatal "failed to cd to '${preset_path}'"

  # shellcheck source=presets/x86-64-qemu/preset.sh
  . "${preset_path}/preset.sh" || msg_fatal "Can't source '${preset_path}/preset.sh'"
}

if (($# < 1)); then
  echo "No preset provided"
fi

preset_path="$(realpath "${1}")"
preset_name="$(basename "${preset_path}")"
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/mkdistro-${preset_name}.XXXXXX")"
fakeroot_save="${tmp_dir}/apkroot-fakeroot.save"
apk_root="${tmp_dir}/apkroot"
apk_lockfile="${tmp_dir}/${preset_name}.lock"
root_partition_filelist="${tmp_dir}/root_partition.build"
root_partition_out="${tmp_dir}/root_partition.part"

boot_partition_filelist="${tmp_dir}/boot_partiton.build"
boot_partition_out="${tmp_dir}/boot_partition.part"

disk_layout_filelist="${tmp_dir}/disk.build"
disk_layout_out="${tmp_dir}/disk.img"

#Pre generate the save file
fakeroot -s "${fakeroot_save}" -- true

read_preset
validate_preset
build_image
