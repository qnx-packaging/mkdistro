#!/usr/bin/env bash
#
# mkdistro [OPTIONS] <preset>
#
# Build a QNX disk image from a preset directory.

set -Eeuo pipefail
shopt -s inherit_errexit

script_path="$(realpath -e -- "${BASH_SOURCE[0]}")"
script_dir="$(dirname -- "${script_path}")"

# shellcheck source=steps/prelude.sh
source "${script_dir}/steps/prelude.sh"

# global variables
preset_path=""
preset_name=""
out_dir="./out"
data_dir=""
fakeroot_save=""
steps_dir=""
common_dir=""
tmp_dir=""
apk_root=""
apk_lockfile=""
root_partition_filelist=""
root_partition_out=""
boot_partition_filelist=""
boot_partition_out=""
disk_layout_filelist=""
disk_layout_out=""
keep_tmp=false

# preset variables
arch=""
boot_partition_type=""
boot_partition_size=0
boot_partition_layout=""
image_size=0
image_format=""
image_inodes=""
repositories=()
local_repositories=()
packages=()
keys=()
users=()
groups=()
openrc_services=()
declare -A openrc_confd=()
declare -A file_permissions=()

#--- setup -------------------------------------------------------------------

usage() {
  cat <<'EOF'
mkdistro [OPTIONS] <preset>

  Build a QNX disk image from <preset>, a directory containing a mkdistro.conf.

Options:
  -h, --help      Show this help and exit.
  -o, --output DIR
                  Directory for the finished files. Default: ./out, relative to
                  the directory mkdistro was run from. Created if missing. On a
                  successful build the disk image and the apk lock file are
                  copied there as <preset>_<YYYYMMDD>.<ext> and
                  <preset>_<YYYYMMDD>.lock.
  --keep-tmp      Keep the temporary build directory after a successful build.
                  A failed build always keeps it, and prints where.

Data directory: $MKDISTRO_DATADIR, else next to the mkdistro script. See
README.md.

EOF
}

usage_err() {
  usage >&2
  die "${1}"
}

on_err() {
  local line="${1}" cmd="${2}" status="${3}"
  printf '[%s] FATAL: line %s failed (exit %s): %s\n' "${PROG}" "${line}" "${status}" "${cmd}" >&2
  quit 1
}

on_exit() {
  local status=$?

  if [[ -z ${tmp_dir} || ! -d ${tmp_dir} ]]; then
    return "${status}"
  elif [[ ${status} != 0 ]]; then
    warning "keeping temporary directory on failed build: ${tmp_dir}"
    return "${status}"
  elif [[ ${keep_tmp} == true  ]]; then
    msg "keeping temporary directory: ${tmp_dir}"
    return "${status}"
  else
    rm -rf "${tmp_dir}"
    return "${status}"
  fi
}

find_datadir() {
  local dir="${MKDISTRO_DATADIR:-${script_dir}}"
  local origin="the directory of ${script_path}"
  if [[ -n "${MKDISTRO_DATADIR:-}" ]]; then
    origin="MKDISTRO_DATADIR"
  fi

  if [[ ! -d "${dir}/steps" || ! -d "${dir}/common" ]]; then
    die "no mkdistro data directory found: ${origin} ('${dir}') does not contain steps/ and common/"
  fi

  data_dir="$(realpath -e -- "${dir}")" || die "cannot resolve data directory: ${dir}"
  steps_dir="${data_dir}/steps"
  common_dir="${data_dir}/common"
}

require_tools() {
  local -a required=(
    # System tools
    fakeroot apk sed curl awk find numfmt mktemp realpath getopt
    # SDP tools
    diskimage mkfatfsimg mkqnx6fsimg mkshadow
    # Image gen tools
    mkdyifs
  )
  local -a missing=()
  local tool

  if [[ "${image_format}" == "qcow2" ]]; then
    required+=(qemu-img)
  fi

  for tool in "${required[@]}"; do
    if ! command -v "${tool}" &>/dev/null; then
      missing+=("${tool}")
    fi
  done

  if ((${#missing[@]} > 0)); then
    die "missing required tool(s): ${missing[*]}"
  fi
}

#--- build steps -------------------------------------------------------------

generate_image() {
  # Padding so the last sector is never right at the edge of the image
  local -i pad_sectors=4096
  local -i image_bytes=0
  local -i sectors=0

  image_bytes="$(to_bytes_checked image_size "${image_size}")"
  sectors=$((image_bytes / 512 + pad_sectors))
  msg "Generating disk image"

  cat <<EOF >"${disk_layout_filelist}"
[cylinders=${sectors}]
[heads=1 sectors_per_track=1 sector_size=512 start_at_cylinder=2048]
[partition=1 type_guid="${boot_partition_type}" boot=true] "${boot_partition_out}"
[partition=2 type_guid="qnx6"] "${root_partition_out}"
EOF

  diskimage -g -S -c "${disk_layout_filelist}" -o "${disk_layout_out}" >/dev/null \
    || die "diskimage failed; see ${disk_layout_filelist}"

  if [[ "${image_format}" == "qcow2" ]]; then
    msg "Converting to qcow2 format"
    local qcow2_out="${disk_layout_out%.*}.qcow2"
    qemu-img convert -f raw -O qcow2 -c -S 4k "${disk_layout_out}" "${qcow2_out}" \
      || die "qemu-img convert failed for ${disk_layout_out}"
    rm -f -- "${disk_layout_out}"
    disk_layout_out="${qcow2_out}"
  fi
}

generate_boot_partition() {
  local sectors="$1"
  local layout_path=""
  local size=""

  size="$(from_bytes $((sectors * 512)))"
  msg "Generating boot partition with size ${size}"

  if [[ "${boot_partition_type}" == "efi" && "${boot_partition_layout}" == "" ]]; then
    layout_path="${common_dir}/efi_${arch}.build"
  else
    layout_path="${preset_path}/${boot_partition_layout}.build"
  fi

  if [[ ! -s "${layout_path}" ]]; then
    die "no boot partition layout for boot_partition_type='${boot_partition_type}' (custom layouts are not supported yet; looked for ${layout_path:-<none>})"
  fi

  echo "[num_sectors=${sectors}]" >"${boot_partition_filelist}"
  echo "[search=${tmp_dir}:${apk_root}]" >>"${boot_partition_filelist}"
  cat "${layout_path}" >>"${boot_partition_filelist}"

  mkfatfsimg -r "${tmp_dir}" "${boot_partition_filelist}" "${boot_partition_out}" \
    || die "mkfatfsimg failed; see ${boot_partition_filelist}"
}

generate_root_partition() {
  local sectors="$1"
  local size=""

  if [[ "${image_inodes}" == "auto" ]]; then
    echo "[num_sectors=${sectors}]" >"${root_partition_filelist}"
  else
    echo "[num_sectors=${sectors} num_inodes=${image_inodes}]" >"${root_partition_filelist}"
  fi
  # Reads only, so the save file is not written back: the filelist must not
  # change the staged root or its staging.
  fakeroot -i "${fakeroot_save}" -- "${steps_dir}/filelist-gen.sh" "${apk_root}" "${root_partition_filelist}"

  size="$(from_bytes $((sectors * 512)))"
  msg "Generating root partition with size ${size}"

  mkqnx6fsimg -d "${root_partition_filelist}" "${root_partition_out}" \
    || die "mkqnx6fsimg failed; see ${root_partition_filelist}"
}

generate_partitions() {
  local -i boot_sectors=0
  local -i root_sectors=0
  local -i boot_bytes=0
  local -i image_bytes=0

  boot_bytes="$(to_bytes_checked boot_partition_size "${boot_partition_size}")"
  image_bytes="$(to_bytes_checked image_size "${image_size}")"

  boot_sectors=$((boot_bytes / 512))
  # Root sectors is the amount of space left AFTER the boot partition
  root_sectors=$((image_bytes / 512 - boot_sectors))

  if ((root_sectors <= 0)); then
    die "image_size (${image_size}) is not larger than boot_partition_size (${boot_partition_size})"
  fi

  generate_boot_partition "${boot_sectors}"
  generate_root_partition "${root_sectors}"
}

generate_ifs() {
  pushd "${tmp_dir}" >/dev/null
  MKIFS_PATH="${apk_root}/usr/bin/:${apk_root}/usr/lib/:${apk_root}/usr/lib/dll/:${apk_root}/boot/sys" \
    mkdyifs "${preset_path}/mkdyifs.conf" "${tmp_dir}"
  popd >/dev/null
}

copy_overlay() {
  in_fakeroot install -d -m0775 -o 0 -g 0 -- "${apk_root}" || die "unable to create ${apk_root}"

  if [[ -d "${preset_path}/overlay" ]]; then
    msg "Copying custom overlay"
    cp -afv --no-preserve=ownership,mode -- "${preset_path}/overlay/." "${apk_root}" \
      || die "failed to copy overlay from ${preset_path}/overlay"

    local filename file_path
    local -a fields=()
    for filename in "${!file_permissions[@]}"; do
      IFS=: read -r -a fields <<<"${file_permissions["${filename}"]}"
      local uid="${fields[0]:-}"
      local gid="${fields[1]:-}"
      local permissions="${fields[2]:-}"
      file_path="${apk_root}${filename}"

      # Prevent path traversal
      if ! [[ "$(realpath -qm -- "${file_path}")" == "${apk_root}"* ]]; then
        die "Unable to set permissions for ${file_path}, file \"${filename}\" outside of ${apk_root}"
      elif ! [[ -e "${file_path}" ]]; then
        die "Unable to set permissions for ${file_path}, file \"${filename}\" does not exist"
      else
        in_fakeroot chown -fh -- "${uid}:${gid}" "${file_path}" \
          || die "unable to set ownership on ${file_path}"
        in_fakeroot chmod -f -- "${permissions}" "${file_path}" \
          || die "unable to set mode on ${file_path}"
      fi
    done
  fi
}

setup_passwd() {
  in_fakeroot "${steps_dir}/passwd-gen.sh" "${apk_root}" \
    <(printf '%s\n' "${users[@]}") <(printf '%s\n' "${groups[@]}") \
    || die "passwd generation failed"
}

configure_openrc() {
  local service confd

  # Enable top level services
  for service in "${openrc_services[@]}"; do
    in_fakeroot "${steps_dir}/openrc-enable-service.sh" "${apk_root}" "${service}" \
      || die "failed to enable service '${service}'"
  done

  for confd in "${!openrc_confd[@]}"; do
    in_fakeroot "${steps_dir}/openrc-configure-service.sh" "${apk_root}" "${confd}" \
      <(printf '%s\n' "${openrc_confd[${confd}]}") \
      || die "failed to configure service '${confd}'"
  done
}

embed_local_repositories() {
  local repos_file="${apk_root}/etc/apk/repositories"
  local -a new_lines=()
  local repo repo_path embed_path entry line changed

  if [[ ! -f "${repos_file}" ]]; then
    die "expected ${repos_file} to exist after installing packages"
  fi

  mapfile -t new_lines <"${repos_file}"

  for entry in "${local_repositories[@]}"; do
    if [[ "${entry}" == *::* ]]; then
      embed_path="${entry%%::*}"
      repo="${entry#*::}"
    else
      embed_path=""
      repo="${entry}"
    fi

    repo_path="$(realpath -qe -- "${repo}")" || die "local repository '${repo}' does not exist"

    changed=0
    for line in "${!new_lines[@]}"; do
      if [[ "${new_lines[line]}" == "${repo}" || "${new_lines[line]}" == "${repo_path}" ]]; then
        new_lines["${line}"]="${embed_path}"
        changed=1
      fi
    done

    if ((changed == 0)); then
      die "\"${repo}\" is listed in local_repositories but not in ${repos_file}; it is not one of the preset's repositories"
    fi

    if [[ -z "${embed_path}" ]]; then
      msg "removing \"${repo}\" from <apk-root>/etc/apk/repositories (no embed path)"
      continue
    fi

    msg "copying \"${repo}\" to \"<apk-root>${embed_path}\""
    in_fakeroot mkdir -p -- "${apk_root}/${embed_path}" \
      || die "unable to create ${apk_root}/${embed_path}"
    in_fakeroot cp -r "${repo}/${arch}" "${apk_root}/${embed_path}/${arch}" \
      || die "unable to copy ${repo} into the image"
  done

  local -a out_lines=()
  for line in "${new_lines[@]}"; do
    [[ -z "${line}" ]] && continue
    out_lines+=("${line}")
  done

  if ((${#out_lines[@]} > 0)); then
    printf '%s\n' "${out_lines[@]}" >"${repos_file}"
  else
    : >"${repos_file}"
  fi
}

make_apk_root() {
  local -a args=(--root "${apk_root}" --arch "${arch}" --lockfile "${apk_lockfile}")
  local repo key

  for repo in "${repositories[@]}"; do
    args+=(--repo "${repo}")
  done

  for key in "${keys[@]}"; do
    args+=(--key "${key}")
  done

  for repo in "${local_repositories[@]}"; do
    args+=(--repo "$(realpath -- "${repo#*::}")")
  done

  in_fakeroot "${steps_dir}/apk-dump.sh" "${args[@]}" "${packages[@]}" || die "apk-dump failed"

  msg "copying local repositories"
  embed_local_repositories
}

build_image() {
  copy_overlay
  make_apk_root
  configure_openrc
  setup_passwd
  generate_ifs

  generate_partitions
  generate_image
}

#--- preset ------------------------------------------------------------------

read_preset() {
  if [[ ! -d "${preset_path}" ]]; then
    die "preset at '${preset_path}' does not exist"
  elif [[ ! -e "${preset_path}/mkdistro.conf" ]]; then
    die "preset at '${preset_path}' does not contain a 'mkdistro.conf' file"
  fi

  cd -- "${preset_path}" || die "failed to cd to '${preset_path}'"

  # shellcheck source=presets/x86_64-qemu/mkdistro.conf disable=SC1091
  . "${preset_path}/mkdistro.conf" || die "can't source '${preset_path}/mkdistro.conf'"
}

make_work_dir() {
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/mkdistro-${preset_name}.XXXXXX")"
  fakeroot_save="${tmp_dir}/apkroot-fakeroot.save"
  apk_root="${tmp_dir}/apkroot"
  apk_lockfile="${tmp_dir}/${preset_name}.lock"
  root_partition_filelist="${tmp_dir}/root_partition.build"
  root_partition_out="${tmp_dir}/root_partition.part"

  boot_partition_filelist="${tmp_dir}/boot_partition.build"
  boot_partition_out="${tmp_dir}/boot_partition.part"

  disk_layout_filelist="${tmp_dir}/disk.build"
  disk_layout_out="${tmp_dir}/disk.img"

  #Pre generate the save file
  fakeroot -s "${fakeroot_save}" -- true
}

#--- results -----------------------------------------------------------------

copy_results() {
  local date_tag image_ext image_dest lock_dest

  date_tag="$(date +%Y%m%d)"
  image_ext="${disk_layout_out##*.}"
  image_dest="${out_dir}/${preset_name}_${date_tag}.${image_ext}"
  lock_dest="${out_dir}/${preset_name}_${date_tag}.lock"

  if [[ ! -s "${apk_lockfile}" ]]; then
    die "expected lock file ${apk_lockfile} to exist after the build"
  fi

  cp -f -- "${disk_layout_out}" "${image_dest}" \
    || die "failed to copy image ${disk_layout_out} to ${image_dest}"
  cp -f -- "${apk_lockfile}" "${lock_dest}" \
    || die "failed to copy lock file ${apk_lockfile} to ${lock_dest}"

  msg "Image ready: ${image_dest}"
  msg "Lock file ready: ${lock_dest}"
}

#--- main --------------------------------------------------------------------

trap 'on_err "${LINENO}" "${BASH_COMMAND}" "$?"' ERR
trap 'on_exit' EXIT

while (($#)); do
  case "$1" in
  -h | --help) usage; quit 0 ;;
  -o | --output)
    (($# >= 2)) || usage_err "$1 requires a directory"
    out_dir="${2}"
    shift 2
    ;;
  --keep-tmp) keep_tmp=true; shift ;;
  --) shift; break ;;
  -*) usage_err "unknown option: $1" ;;
  *) break ;;
  esac
done

if (($# != 1)); then
  (($# > 0)) || usage_err "no preset provided"
  usage_err "expected exactly one preset, got $#: $*"
fi

preset_path="$(realpath -m -- "$1")" || die "cannot resolve preset path: $1"
preset_name="$(basename -- "${preset_path}")"
out_dir="$(realpath -m -- "${out_dir}")" || die "cannot resolve output directory: ${out_dir}"

find_datadir
read_preset

# Validation is a standalone step; it prints every problem itself.
"${steps_dir}/validate.sh" "${preset_path}" || quit 1

require_tools

if ! mkdir -p -- "${out_dir}"; then
  die "unable to create output directory: ${out_dir}"
fi

make_work_dir
build_image
copy_results
